@model Generic.Data.GovernmentSubsidy


@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Create Government Subsidy</h1>
}

<div asp-validation-summary="All"></div>

<form method="post" asp-controller="GovernmentSubsidy" asp-action="Create" id="createForm">
    <div class="form-group">
        <label asp-for="GovernmentSubsidyName"></label>
        <input class="form-control" asp-for="GovernmentSubsidyName" />
        <span class="text-danger" asp-validation-for="GovernmentSubsidyName"></span>
    </div>
</form>


<script src="@Url.Content("~/js/GovernmentSubsidy/Create.js")"></script>
