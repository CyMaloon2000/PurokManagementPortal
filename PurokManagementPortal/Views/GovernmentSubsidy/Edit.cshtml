@model Generic.Data.GovernmentSubsidy

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Edit Government Subsidy</h1>
}


<form method="post" asp-controller="GovernmentSubsidy" asp-action="Edit" id="editForm">
    <div class="form-group" hidden>
        <label asp-for="GovernmentSubsidyId"></label>
        <input asp-for="GovernmentSubsidyId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="GovernmentSubsidyName"></label>
        <input class="form-control" asp-for="GovernmentSubsidyName" />
        <span class="text-danger" asp-validation-for="GovernmentSubsidyName"></span>
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive"></label>
        <span asp-validation-for="IsActive"></span>
    </div>

</form>

<script src="@Url.Content("~/js/GovernmentSubsidy/Edit.js")"></script>