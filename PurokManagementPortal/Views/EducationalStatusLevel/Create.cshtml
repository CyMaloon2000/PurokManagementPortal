@model Generic.Data.EducationalStatusLevel


@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Create Education</h1>
}

<div asp-validation-summary="All"></div>

<form method="post" asp-controller="EducationalStatusLevel" asp-action="Create" id="createForm">
    <div class="form-group">
        <label asp-for="EducationalStatusLevelName"></label>
        <input class="form-control" asp-for="EducationalStatusLevelName" />
        <span class="text-danger" asp-validation-for="EducationalStatusLevelName"></span>
    </div>
    <div class="form-group">
        <label asp-for="LegendRemarks"></label>
        <input class="form-control" asp-for="LegendRemarks" />
        <span class="text-danger" asp-validation-for="LegendRemarks"></span>
    </div>
</form>


<script src="@Url.Content("~/js/EducationalStatusLevel/Create.js")"></script>
