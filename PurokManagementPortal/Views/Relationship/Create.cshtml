@model Generic.Data.Relationship


@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Create Relationship</h1>
}

<div asp-validation-summary="All"></div>

<form method="post" asp-controller="Relationship" asp-action="Create" id="createForm">
    <div class="form-group">
        <label asp-for="RelationshipName"></label>
        <input class="form-control" asp-for="RelationshipName" />
        <span class="text-danger" asp-validation-for="RelationshipName"></span>
    </div>
</form>


<script src="@Url.Content("~/js/Relationship/Create.js")"></script>
