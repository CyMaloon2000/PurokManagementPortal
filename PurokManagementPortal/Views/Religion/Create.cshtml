@model Generic.Data.Religion


@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Create Religion</h1>
}

<div asp-validation-summary="All"></div>

<form method="post" asp-controller="Religion" asp-action="Create" id="createForm">
    <div class="form-group">
        <label asp-for="ReligionName"></label>
        <input class="form-control" asp-for="ReligionName" />
        <span class="text-danger" asp-validation-for="ReligionName"></span>
    </div>
</form>


<script src="@Url.Content("~/js/Religion/Create.js")"></script>
