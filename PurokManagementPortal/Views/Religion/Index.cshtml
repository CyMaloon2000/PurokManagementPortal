@model Generic.Data.Religion

<div class="container-fluid">
    <h1 class="h3 mb-1 text-gray-800">Manage Religion</h1>

    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-sm btn-primary px-4" data-url="/Religion/Create/" data-id="createReligion" data-dialog-title="Create Religion" data-dialog-width="modal-lg" data-process-button="Create" onclick="loadAndShowModal($(this))"><i class="fas fa-plus mr-2 ml-0"></i>Create</button>
    </div>

    <div class="table-responsive">
        <table id="ReligionDT" class="table table-hover table-striped table-bordered nowrap" style="width:100%">
            <thead class="text-center">
                <tr>
                    <th>ReligionName</th>
                    <th>IsActive</th>
                    <th>Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>




@section Scripts {
    <script src="@Url.Content("~/js/Religion/Index.js")"></script>
}