@model Generic.Data.HealthCondition

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Delete Health Condition</h1>
}


<form method="post" asp-controller="HealthCondition" asp-action="Delete" id="deleteForm">
    <div class="form-group" hidden>
        <label asp-for="HealthConditionId"></label>
        <input asp-for="HealthConditionId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="HealthConditionName"></label>
        <input class="form-control" asp-for="HealthConditionName" readonly />
        <span asp-validation-for="HealthConditionName"></span>
    </div>
    <div class="form-group">
        <label asp-for="LegendRemarks"></label>
        <input class="form-control" asp-for="LegendRemarks" readonly />
        <span asp-validation-for="LegendRemarks"></span>
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" disabled />
        <label class="form-check-label" asp-for="IsActive"></label>
        <span asp-validation-for="IsActive"></span>
    </div>

</form>

<script src="@Url.Content("~/js/HealthCondition/Delete.js")"></script>