@model Generic.Data.Person

<div class="container-fluid">
    <h1 class="h3 mb-1 text-gray-800">Manage Person</h1>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-sm btn-primary px-4" asp-controller="Person" asp-action="Create"><i class="fas fa-plus mr-2 ml-0"></i>Create</a>
       
    </div>

    <div class="table-responsive-md">
        <table id="PersonDT" class="table table-hover table-striped table-bordered nowrap" style="width:100%">
            <thead>
                <tr class="text-center">
                    <th>Full Name</th>
                    <th>Gender</th>
                    <th>Birth Date</th>
                    <th>Marital Status</th>
                    <th>Birth Cert.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script src="@Url.Content("~/js/Person/Index.js")"></script>
}