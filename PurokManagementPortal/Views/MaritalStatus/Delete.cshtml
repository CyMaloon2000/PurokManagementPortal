@model Generic.Data.MaritalStatus

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Delete Marital Status</h1>
}


<form method="post" asp-controller="MaritalStatus" asp-action="Delete" id="deleteForm">
    <div class="form-group" hidden>
        <label asp-for="MaritalStatusId"></label>
        <input asp-for="MaritalStatusId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="StatusName"></label>
        <input class="form-control" asp-for="StatusName" readonly />
        <span asp-validation-for="StatusName"></span>
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" disabled />
        <label class="form-check-label" asp-for="IsActive"></label>
        <span asp-validation-for="IsActive"></span>
    </div>

</form>

<script src="@Url.Content("~/js/MaritalStatus/Delete.js")"></script>