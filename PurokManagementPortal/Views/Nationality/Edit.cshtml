@model Generic.Data.Nationality

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Edit Nationality</h1>
}


<form method="post" asp-controller="Nationality" asp-action="Edit" id="editForm">
    <div class="form-group" hidden>
        <label asp-for="NationalityId"></label>
        <input asp-for="NationalityId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="NationalityName"></label>
        <input class="form-control" asp-for="NationalityName" />
        <span class="text-danger" asp-validation-for="NationalityName"></span>
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" />
        <label class="form-check-label" asp-for="IsActive"></label>
        <span asp-validation-for="IsActive"></span>
    </div>

</form>

<script src="@Url.Content("~/js/Nationality/Edit.js")"></script>