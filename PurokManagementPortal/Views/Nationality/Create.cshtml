@model Generic.Data.Nationality


@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Create Nationality</h1>
}

<div asp-validation-summary="All"></div>

<form method="post" asp-controller="Nationality" asp-action="Create" id="createForm">
    <div class="form-group">
        <label asp-for="NationalityName"></label>
        <input class="form-control" asp-for="NationalityName" />
        <span class="text-danger" asp-validation-for="NationalityName"></span>
    </div>
</form>


<script src="@Url.Content("~/js/Nationality/Create.js")"></script>
