@model Generic.Data.PhilHealthSource

@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Delete PhilHealth Source</h1>
}


<form method="post" asp-controller="PhilHealthSource" asp-action="Delete" id="deleteForm">
    <div class="form-group" hidden>
        <label asp-for="PhilHealthSourceId"></label>
        <input asp-for="PhilHealthSourceId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="PhilHealthSourceName"></label>
        <input class="form-control" asp-for="PhilHealthSourceName" readonly />
        <span asp-validation-for="PhilHealthSourceName"></span>
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" disabled />
        <label class="form-check-label" asp-for="IsActive"></label>
        <span asp-validation-for="IsActive"></span>
    </div>

</form>

<script src="@Url.Content("~/js/PhilHealthSource/Delete.js")"></script>