@model Generic.Data.Gender

@if(Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Delete Gender</h1>
}


<form method="post" asp-controller="Gender" asp-action="Delete" id="deleteForm">
    <div class="form-group" hidden>
        <label asp-for="GenderId"></label>
        <input asp-for="GenderId" readonly />
    </div>
    <div class="form-group">
        <label asp-for="GenderName"></label>
        <input class="form-control" asp-for="GenderName" readonly/>
        <span asp-validation-for="GenderName"></span>
    </div>
    <div class="form-group">
        <input type="checkbox" asp-for="IsActive" disabled />
        <label class="form-check-label" asp-for="IsActive" ></label>
        <span asp-validation-for="IsActive"></span>
    </div>

</form>

<script src="@Url.Content("~/js/Gender/Delete.js")"></script>