@model Generic.Data.Gender


@if (Context.Request.Headers["X-Requested-With"] != "XMLHttpRequest")
{
    <h1 class="h3 mb-1 text-gray-800">Create Gender</h1>
}

<div asp-validation-summary="All"></div>

<form method="post" asp-controller="Gender" asp-action="Create" id="createForm">
    <div class="form-group">
        <label asp-for="GenderName"></label>
        <input class="form-control" asp-for="GenderName" />
        <span class="text-danger" asp-validation-for="GenderName"></span>
    </div>
</form>


<script src="@Url.Content("~/js/Gender/Create.js")"></script>
